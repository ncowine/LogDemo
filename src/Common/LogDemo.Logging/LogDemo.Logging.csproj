<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core logging infrastructure shared by every app: ILoggerFactory setup (MEL + Serilog file sink),
    one file per session, retention, safe configuration loading. No UI code, so netstandard2.0
    runs unchanged on .NET Framework 4.7.2 and .NET 8/10.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>LogDemo.Logging</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LogDemo.Logging.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One project, two runtimes: `dotnet run -f net8.0-windows` or `-f net10.0-windows`. -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <AssemblyName>LogDemo.Net</AssemblyName>
    <RootNamespace>LogDemo.App.Net</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Only the logging core is shared; everything else in this app is its own. -->
  <ItemGroup>
    <ProjectReference Include="..\Common\LogDemo.Logging\LogDemo.Logging.csproj" />
    <ProjectReference Include="..\Common\LogDemo.Logging.Wpf\LogDemo.Logging.Wpf.csproj" />
    <!-- Opt-in: central export to the observability stack (pulls in the OpenTelemetry packages). -->
    <ProjectReference Include="..\Common\LogDemo.Logging.Observability\LogDemo.Logging.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Prism.DryIoc" />
    <!-- Direct reference so the [LoggerMessage] source generator runs in this project. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Window x:Class="LogDemo.App.Net.Views.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:app="clr-namespace:LogDemo.App.Net"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        Width="960" Height="580" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding LogFilePath, StringFormat='Logging to {0}'}"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Left" Width="190" Background="{StaticResource SidebarBrush}">
            <StackPanel Margin="10,16">
                <TextBlock Text="LogDemo" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,16"
                           Foreground="{StaticResource AccentBrush}" />
                <Button Style="{StaticResource NavButton}" Content="Customers"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static app:ViewNames.Customers}" />
                <Button Style="{StaticResource NavButton}" Content="Diagnostics"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static app:ViewNames.Diagnostics}" />
            </StackPanel>
        </Border>

        <ContentControl Margin="20,16" prism:RegionManager.RegionName="{x:Static app:RegionNames.Content}" />
    </DockPanel>
</Window>

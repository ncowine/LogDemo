{
  // Standard Microsoft.Extensions.Logging filters. Changes apply while the app is running.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "LogDemo.App.Net.Commands": "Information",
      "Microsoft": "Warning"
    },
    // What is sent to the collector. Without this section the export uses the rules above.
    "OpenTelemetry": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  },

  // File settings. Applied at startup.
  "FileLogging": {
    "Directory": "",   // empty = Documents\LogDemo\{version}
    "RetentionDays": 7,
    "MaxRetainedFiles": 100,
    "MaxFileSizeMB": 20
  },

  // Central export of logs and traces to the OpenTelemetry Collector (OTLP/HTTP). Applied at startup.
  // Empty Endpoint = file only. Production: the collector on the observability host, e.g. http://10.20.30.40:4318
  // (127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and a refused connect costs ~2 s.)
  "Telemetry": {
    "Endpoint": "http://127.0.0.1:4318",
    "Environment": "development"
  }
}

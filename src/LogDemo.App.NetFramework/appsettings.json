{
  // Standard Microsoft.Extensions.Logging filters. Changes apply while the app is running.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "LogDemo.App.NetFramework.Commands": "Information",
      "Microsoft": "Warning"
    }
  },

  // File settings. Applied at startup.
  "FileLogging": {
    "Directory": "%LOCALAPPDATA%\\Contoso\\LogDemo\\Logs",
    "RetentionDays": 7,
    "MaxRetainedFiles": 100,
    "MaxFileSizeMB": 20
  }
}

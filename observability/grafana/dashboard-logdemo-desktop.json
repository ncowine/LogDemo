      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count(count by (user_name) (count_over_time({service_namespace=\"desktop\", service_name=~\"$service\"} | user_name=~\"(?i).*$user.*\" | severity_number >= 17 [$__range]))) or vector(0)",
          "queryType": "instant"

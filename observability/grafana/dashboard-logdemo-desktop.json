          },
          "editorMode": "code",
          "expr": "{service_namespace=\"desktop\", service_name=~\"$service\"} | user_name=~\"(?i).*$user.*\" | severity_number >= 17",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Session drill-down",
      "description": "Everything one app start sent (Information and above). Put a session id in the Session box: it is on every record, in the alert, and in the header of the local log file.",

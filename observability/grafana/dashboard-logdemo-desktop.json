    {
      "id": 11,
      "type": "logs",
      "title": "Recent errors and crashes",
      "description": "Expand a line for user, machine, session, exception and stack trace. The TraceID link opens the command's trace in Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {

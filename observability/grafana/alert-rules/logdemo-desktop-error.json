{
  "uid": "logdemo-desktop-error",
  "title": "Desktop app error",
  "condition": "THRESHOLD",
  "folderUID": "logdemo",
  "ruleGroup": "logdemo-desktop",
  "orgID": 1,
  "for": "0s",
  "noDataState": "OK",
  "execErrState": "OK",
  "labels": {
    "severity": "warning",
    "service": "logdemo-desktop"
  },
  "annotations": {
    "summary": "{{ $labels.service_name }} {{ $labels.service_version }}: {{ $labels.exception_type }} for {{ $labels.user_name }}",
    "description": "{{ $values.THRESHOLD.Value }} error record(s) in the last 5 minutes on {{ $labels.host_name }}; the app kept running. Explore: {service_namespace=\"desktop\"} | user_name=\"{{ $labels.user_name }}\" | severity_number >= 17"
  },
  "data": [
    {
      "refId": "QUERY",
      "relativeTimeRange": {
        "from": 300,
        "to": 0
      },
      "datasourceUid": "loki",
      "model": {
        "refId": "QUERY",
        "editorMode": "code",
        "queryType": "instant",
        "expr": "sum by (service_name, service_version, user_name, host_name, exception_type) (count_over_time({service_namespace=\"desktop\"} | severity_number >= 17 | severity_number < 21 [5m]))"
      }
    },
    {
      "refId": "THRESHOLD",
      "relativeTimeRange": {
        "from": 300,
        "to": 0
      },
      "datasourceUid": "__expr__",
      "model": {
        "refId": "THRESHOLD",
        "type": "threshold",
        "expression": "QUERY",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                0
              ]
            }
          }
        ]
      }
    }
  ]
}

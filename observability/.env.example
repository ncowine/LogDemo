# =============================================================================
#  LogDemo desktop telemetry — copy to ".env" in this folder
# =============================================================================
#     cp .env.example .env          (PowerShell: copy .env.example .env)
#     chmod 600 .env                (production: it holds the Grafana password)
# =============================================================================

# ── Image version ────────────────────────────────────────────────────────────
# Pinned, not "latest". The config uses the otlp_http / otlp_grpc exporter names,
# which older collector releases do not know.
COLLECTOR_VERSION=0.162.0

# ── The existing stack ───────────────────────────────────────────────────────
# Its Docker network: <compose project name>_default. `docker network ls` to check.
#   dev stack  (name: cleanarch-dev)   -> cleanarch-dev_default
#   prod stack (name: cleanarch-prod)  -> cleanarch-prod_default
STACK_NETWORK=cleanarch-dev_default

# ── Where the collector listens ──────────────────────────────────────────────
# Dev: 127.0.0.1, matching the apps' default Telemetry:Endpoint.
# Prod: the Docker host's LAN address (the same BIND_ADDR as the stack's .env).
BIND_ADDR=127.0.0.1

# ── Grafana, for the one-shot dashboard/alert setup ──────────────────────────
# Dev: leave the password empty; the dev stack's Grafana has an anonymous admin.
# Prod: the stack's GRAFANA_ADMIN_USER / GRAFANA_ADMIN_PASSWORD.
GRAFANA_URL=http://grafana:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=
